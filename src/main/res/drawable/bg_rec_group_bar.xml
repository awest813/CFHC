<?xml version="1.0" encoding="utf-8"?>
<!-- Recruit group row: elevated slate bar with a gold leading indicator (prospect / star accent). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cf_card_elevated" />
            <corners android:radius="@dimen/cf_radius_md" />
            <stroke
                android:width="@dimen/cf_stroke"
                android:color="@color/cf_border" />
        </shape>
    </item>
    <item
        android:gravity="start|fill_vertical"
        android:width="@dimen/cf_nav_indicator">
        <shape android:shape="rectangle">
            <solid android:color="@color/cf_gold" />
            <corners
                android:bottomLeftRadius="@dimen/cf_radius_md"
                android:topLeftRadius="@dimen/cf_radius_md" />
        </shape>
    </item>
</layer-list>
