<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cf_crimson_bright" />
            <corners android:radius="@dimen/cf_radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cf_crimson" />
            <corners android:radius="@dimen/cf_radius_md" />
            <stroke
                android:width="@dimen/cf_stroke"
                android:color="@color/cf_crimson_bright" />
        </shape>
    </item>
</selector>
