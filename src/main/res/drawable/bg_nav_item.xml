<?xml version="1.0" encoding="utf-8"?>
<!-- Checked drawer row: emerald wash plus a 4dp bar on the leading edge. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/cf_emerald_glow" />
                </shape>
            </item>
            <item
                android:width="@dimen/cf_nav_indicator"
                android:gravity="start|fill_vertical">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cf_emerald" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
