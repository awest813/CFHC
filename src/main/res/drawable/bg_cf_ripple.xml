<?xml version="1.0" encoding="utf-8"?>
<!-- Press feedback for card rows: emerald ripple clipped to the 8dp card corners. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/cf_emerald_dim">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/cf_text_primary" />
            <corners android:radius="@dimen/cf_radius_md" />
        </shape>
    </item>
</ripple>
