<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ extraction rules: saves/exports participate in cloud backup and
     device transfer (see backup_rules.xml for the rationale). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <include domain="external" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="external" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
