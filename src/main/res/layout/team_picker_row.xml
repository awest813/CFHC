<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cf_card"
    android:foreground="@drawable/bg_cf_ripple"
    android:gravity="center_vertical"
    android:minHeight="@dimen/cf_row_height_lg"
    android:orientation="horizontal"
    android:paddingStart="@dimen/cf_card_padding_h"
    android:paddingTop="@dimen/cf_space_sm"
    android:paddingEnd="@dimen/cf_card_padding_h"
    android:paddingBottom="@dimen/cf_space_sm">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pickerRowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Title"
            tools:text="Pine Valley State" />

        <TextView
            android:id="@+id/pickerRowMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_xxs"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption"
            tools:text="Owls  ·  Great North" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cf_space_md"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.Cfhc.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/picker_prestige_label" />

        <TextView
            android:id="@+id/pickerRowPrestige"
            style="@style/Widget.Cfhc.Pill.Gold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_xxs"
            android:minWidth="@dimen/cf_touch_target"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatAccent"
            tools:text="78" />
    </LinearLayout>
</LinearLayout>
