<?xml version="1.0" encoding="utf-8"?>
<!-- Box score shell: view spinner, scoreline hero, quarter table (mono, right-aligned),
     summary sections (label left in Inter, stat columns in mono), play-by-play card. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollerGameDialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog_surface"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/cf_space_lg"
        android:paddingTop="@dimen/cf_space_lg"
        android:paddingEnd="@dimen/cf_space_lg"
        android:paddingBottom="@dimen/cf_space_lg">

        <!-- Shell header: pill + view selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.Cfhc.Pill.Emerald"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dlg_pill_live" />

            <TextView
                style="@style/Widget.Cfhc.CardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cf_space_md"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/dlg_box_view" />
        </LinearLayout>

        <Spinner
            android:id="@+id/boxscoreMenu"
            style="@style/Widget.Cfhc.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:minHeight="44dp" />

        <!-- Scoreline hero -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_md"
            android:background="@drawable/bg_dialog_section"
            android:orientation="vertical"
            android:paddingStart="@dimen/cf_card_padding_h"
            android:paddingTop="@dimen/cf_card_padding_v"
            android:paddingEnd="@dimen/cf_card_padding_h"
            android:paddingBottom="@dimen/cf_card_padding_v">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gameDialogScoreAway"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatBold"
                    android:textColor="@color/cf_text_primary"
                    android:textSize="40sp"
                    tools:text="31" />

                <TextView
                    android:id="@+id/gameDialogScoreDash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cf_space_sm"
                    android:layout_marginEnd="@dimen/cf_space_sm"
                    android:text="@string/dlg_score_separator"
                    android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat"
                    android:textColor="@color/cf_text_muted"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/gameDialogScoreHome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatBold"
                    android:textColor="@color/cf_text_primary"
                    android:textSize="40sp"
                    tools:text="27" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_xs"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gameDialogScoreAwayName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.Cfhc.Cf.Title"
                    android:textColor="@color/cf_text_secondary"
                    tools:text="AWAY\n(7-2)" />

                <TextView
                    android:id="@+id/gameDialogScoreDashName"
                    style="@style/Widget.Cfhc.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cf_space_sm"
                    android:layout_marginEnd="@dimen/cf_space_sm"
                    tools:text="\@" />

                <TextView
                    android:id="@+id/gameDialogScoreHomeName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.Cfhc.Cf.Title"
                    android:textColor="@color/cf_text_secondary"
                    tools:text="HOME\n(6-3)" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quarter table -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:background="@drawable/bg_dialog_section"
            android:orientation="vertical"
            android:paddingStart="@dimen/cf_card_padding_h"
            android:paddingTop="@dimen/cf_card_padding_v"
            android:paddingEnd="@dimen/cf_card_padding_h"
            android:paddingBottom="@dimen/cf_card_padding_v">

            <TextView
                style="@style/Widget.Cfhc.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dlg_box_scoring" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_sm"
                android:shrinkColumns="0"
                android:stretchColumns="0">

                <TableRow>
                    <TextView android:id="@+id/scoreboard" style="@style/Widget.Cfhc.CardTitle" android:gravity="start|center_vertical" android:minHeight="32dp" android:paddingEnd="@dimen/cf_space_sm" android:text="@string/dlg_box_col_team" />
                    <TextView android:id="@+id/scoreQT1" style="@style/Widget.Cfhc.CardTitle" android:gravity="end|center_vertical" android:minHeight="32dp" android:minWidth="36dp" android:text="@string/dlg_box_col_q1" />
                    <TextView android:id="@+id/scoreQT2" style="@style/Widget.Cfhc.CardTitle" android:gravity="end|center_vertical" android:minHeight="32dp" android:minWidth="36dp" android:text="@string/dlg_box_col_q2" />
                    <TextView android:id="@+id/scoreQT3" style="@style/Widget.Cfhc.CardTitle" android:gravity="end|center_vertical" android:minHeight="32dp" android:minWidth="36dp" android:text="@string/dlg_box_col_q3" />
                    <TextView android:id="@+id/scoreQT4" style="@style/Widget.Cfhc.CardTitle" android:gravity="end|center_vertical" android:minHeight="32dp" android:minWidth="36dp" android:text="@string/dlg_box_col_q4" />
                    <TextView android:id="@+id/scoreOT" style="@style/Widget.Cfhc.CardTitle" android:gravity="end|center_vertical" android:minHeight="32dp" android:minWidth="40dp" android:text="@string/dlg_box_col_ot" />
                </TableRow>

                <View android:layout_width="match_parent" android:layout_height="@dimen/cf_stroke" android:background="@color/cf_divider" />

                <TableRow>
                    <TextView android:id="@+id/teamAway" android:gravity="start|center_vertical" android:minHeight="36dp" android:paddingEnd="@dimen/cf_space_sm" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Title" tools:text="AWAY" />
                    <TextView android:id="@+id/awayQT1" android:gravity="end|center_vertical" android:minHeight="36dp" android:minWidth="36dp" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" tools:text="7" />
                    <TextView android:id="@+id/awayQT2" android:gravity="end|center_vertical" android:minHeight="36dp" android:minWidth="36dp" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" tools:text="10" />
                    <TextView android:id="@+id/awayQT3" android:gravity="end|center_vertical" android:minHeight="36dp" android:minWidth="36dp" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" tools:text="7" />
                    <TextView android:id="@+id/awayQT4" android:gravity="end|center_vertical" android:minHeight="36dp" android:minWidth="36dp" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" tools:text="7" />
                    <TextView android:id="@+id/awayOT" android:gravity="end|center_vertical" android:minHeight="36dp" android:minWidth="40dp" android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatBold" tools:text="0" />
                </TableRow>

                <TableRow>
                    <TextView android:id="@+id/teamHome" android:gravity="start|center_vertical" android:minHeight="36dp" android:paddingEnd="@dimen/cf_space_sm" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Title" tools:text="HOME" />
                    <TextView android:id="@+id/homeQT1" android:gravity="end|center_vertical" android:minHeight="36dp" android:minWidth="36dp" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" tools:text="3" />
                    <TextView android:id="@+id/homeQT2" android:gravity="end|center_vertical" android:minHeight="36dp" android:minWidth="36dp" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" tools:text="14" />
                    <TextView android:id="@+id/homeQT3" android:gravity="end|center_vertical" android:minHeight="36dp" android:minWidth="36dp" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" tools:text="7" />
                    <TextView android:id="@+id/homeQT4" android:gravity="end|center_vertical" android:minHeight="36dp" android:minWidth="36dp" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" tools:text="3" />
                    <TextView android:id="@+id/homeOT" android:gravity="end|center_vertical" android:minHeight="36dp" android:minWidth="40dp" android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatBold" tools:text="0" />
                </TableRow>
            </TableLayout>
        </LinearLayout>

        <!-- Summary sections: label row (CardTitle) + home/away mono stat columns -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:background="@drawable/bg_dialog_section"
            android:orientation="vertical"
            android:paddingStart="@dimen/cf_card_padding_h"
            android:paddingTop="@dimen/cf_card_padding_v"
            android:paddingEnd="@dimen/cf_card_padding_h"
            android:paddingBottom="@dimen/cf_card_padding_v">

            <TextView
                style="@style/Widget.Cfhc.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dlg_box_summary" />

            <!-- Home = layout-start column, away = layout-end; paddingStart/End keeps gutter between teams in RTL/LTR. -->
            <TextView android:id="@+id/gameDialogLeft" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_sm" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Title" android:textColor="@color/cf_gold" tools:text="Summary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_xs" android:orientation="horizontal">
                <TextView android:id="@+id/gameDialogCenter" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="start" android:paddingStart="0dp" android:paddingEnd="@dimen/cf_space_sm" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" android:textColor="@color/cf_text_secondary" tools:text="Home summary" />
                <TextView android:id="@+id/gameDialogRight" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:paddingStart="@dimen/cf_space_sm" android:paddingEnd="0dp" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" android:textColor="@color/cf_text_secondary" tools:text="Away summary" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="@dimen/cf_stroke" android:layout_marginTop="@dimen/cf_space_md" android:background="@color/cf_divider" />

            <TextView android:id="@+id/gameDialogQBLeft" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_md" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Title" android:textColor="@color/cf_gold" tools:text="Passing" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_xs" android:orientation="horizontal">
                <TextView android:id="@+id/gameDialogQBCenter" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="start" android:paddingStart="0dp" android:paddingEnd="@dimen/cf_space_sm" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" android:textColor="@color/cf_text_secondary" tools:text="Home passing" />
                <TextView android:id="@+id/gameDialogQBRight" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:paddingStart="@dimen/cf_space_sm" android:paddingEnd="0dp" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" android:textColor="@color/cf_text_secondary" tools:text="Away passing" />
            </LinearLayout>

            <TextView android:id="@+id/gameDialogRushLeft" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_md" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Title" android:textColor="@color/cf_gold" tools:text="Rushing" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_xs" android:orientation="horizontal">
                <TextView android:id="@+id/gameDialogRushCenter" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="start" android:paddingStart="0dp" android:paddingEnd="@dimen/cf_space_sm" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" android:textColor="@color/cf_text_secondary" tools:text="Home rushing" />
                <TextView android:id="@+id/gameDialogRushRight" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:paddingStart="@dimen/cf_space_sm" android:paddingEnd="0dp" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" android:textColor="@color/cf_text_secondary" tools:text="Away rushing" />
            </LinearLayout>

            <TextView android:id="@+id/gameDialogRecLeft" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_md" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Title" android:textColor="@color/cf_gold" tools:text="Receiving" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_xs" android:orientation="horizontal">
                <TextView android:id="@+id/gameDialogRecCenter" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="start" android:paddingStart="0dp" android:paddingEnd="@dimen/cf_space_sm" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" android:textColor="@color/cf_text_secondary" tools:text="Home receiving" />
                <TextView android:id="@+id/gameDialogRecRight" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:paddingStart="@dimen/cf_space_sm" android:paddingEnd="0dp" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" android:textColor="@color/cf_text_secondary" tools:text="Away receiving" />
            </LinearLayout>

            <TextView android:id="@+id/gameDialogDefLeft" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_md" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Title" android:textColor="@color/cf_gold" tools:text="Defense" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_xs" android:orientation="horizontal">
                <TextView android:id="@+id/gameDialogDefCenter" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="start" android:paddingStart="0dp" android:paddingEnd="@dimen/cf_space_sm" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" android:textColor="@color/cf_text_secondary" tools:text="Home defense" />
                <TextView android:id="@+id/gameDialogDefRight" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:paddingStart="@dimen/cf_space_sm" android:paddingEnd="0dp" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" android:textColor="@color/cf_text_secondary" tools:text="Away defense" />
            </LinearLayout>

            <TextView android:id="@+id/gameDialogKickLeft" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_md" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Title" android:textColor="@color/cf_gold" tools:text="Kicking" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_xs" android:orientation="horizontal">
                <TextView android:id="@+id/gameDialogKickCenter" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="start" android:paddingStart="0dp" android:paddingEnd="@dimen/cf_space_sm" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" android:textColor="@color/cf_text_secondary" tools:text="Home kicking" />
                <TextView android:id="@+id/gameDialogKickRight" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:paddingStart="@dimen/cf_space_sm" android:paddingEnd="0dp" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat" android:textColor="@color/cf_text_secondary" tools:text="Away kicking" />
            </LinearLayout>
        </LinearLayout>

        <!-- Play by play -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:background="@drawable/bg_dialog_section"
            android:orientation="vertical"
            android:paddingStart="@dimen/cf_card_padding_h"
            android:paddingTop="@dimen/cf_card_padding_v"
            android:paddingEnd="@dimen/cf_card_padding_h"
            android:paddingBottom="@dimen/cf_card_padding_v">

            <TextView
                style="@style/Widget.Cfhc.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dlg_box_play_log" />

            <TextView
                android:id="@+id/gameDialogBottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_sm"
                android:lineSpacingExtra="2dp"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat"
                android:textColor="@color/cf_text_primary"
                tools:text="Q1 15:00 — Kickoff" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
