<?xml version="1.0" encoding="utf-8"?>
<!-- Recruit header row (one prospect). Left: "$cost POS Name" (Inter); right: star grade pill (gold mono). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/cf_space_sm"
    android:background="@drawable/bg_rec_group_bar"
    android:foreground="@drawable/bg_cf_ripple"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/cf_space_lg"
    android:paddingTop="@dimen/cf_space_sm"
    android:paddingEnd="@dimen/cf_space_md"
    android:paddingBottom="@dimen/cf_space_sm">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="@dimen/cf_space_sm">

        <TextView
            style="@style/Widget.Cfhc.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rec_label_prospect" />

        <TextView
            android:id="@+id/textRecruitLeft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Body"
            android:textColor="@color/cf_text_primary"
            tools:text="$320 QB Marcus Reed" />
    </LinearLayout>

    <TextView
        android:id="@+id/textRecruitRight"
        style="@style/Widget.Cfhc.Pill.Gold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        android:paddingStart="@dimen/cf_space_sm"
        android:paddingEnd="@dimen/cf_space_sm"
        android:textAlignment="viewEnd"
        android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatAccent"
        android:textColor="@color/cf_gold"
        tools:text="Grade:  * * * *" />
</LinearLayout>
