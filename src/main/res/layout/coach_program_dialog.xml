<?xml version="1.0" encoding="utf-8"?>
<!-- Coach program & NIL shell: header card (pill + title + summary), upgrades card
     (XP line in mono, branch spinner, gold upgrade CTA, hint), secondary close.
     ids bound by CoachProgramDialogController. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/cf_space_lg"
        android:paddingTop="@dimen/cf_space_lg"
        android:paddingEnd="@dimen/cf_space_lg"
        android:paddingBottom="@dimen/cf_space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog_section"
            android:orientation="vertical"
            android:paddingStart="@dimen/cf_card_padding_h"
            android:paddingTop="@dimen/cf_card_padding_v"
            android:paddingEnd="@dimen/cf_card_padding_h"
            android:paddingBottom="@dimen/cf_card_padding_v">

            <TextView
                style="@style/Widget.Cfhc.Pill.Emerald"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dlg_pill_program" />

            <TextView
                android:id="@+id/textCoachProgramTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_sm"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Display"
                tools:text="Program &amp; NIL" />

            <TextView
                style="@style/Widget.Cfhc.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_md"
                android:text="@string/dlg_program_overview" />

            <TextView
                android:id="@+id/textCoachProgramSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_xs"
                android:lineSpacingExtra="3dp"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Body"
                android:textColor="@color/cf_text_primary"
                tools:text="Program summary" />
        </LinearLayout>

        <!-- NIL collective: tier pill, budget progress toward next tier, real effects. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:background="@drawable/bg_dialog_section"
            android:orientation="vertical"
            android:paddingStart="@dimen/cf_card_padding_h"
            android:paddingTop="@dimen/cf_card_padding_v"
            android:paddingEnd="@dimen/cf_card_padding_h"
            android:paddingBottom="@dimen/cf_card_padding_v">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Cfhc.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/nil_card_title" />

                <TextView
                    android:id="@+id/textNilTier"
                    style="@style/Widget.Cfhc.Pill.Gold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatAccent"
                    tools:text="Tier 2 / 12" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressNilNextTier"
                style="@style/Widget.Cfhc.ProgressBar.Gold"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="@dimen/cf_space_sm"
                android:contentDescription="@string/nil_progress_desc"
                android:max="100"
                tools:progress="65" />

            <TextView
                android:id="@+id/textNilEffects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_sm"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat"
                tools:text="+4.8% home gate · +$190/wk boosters · +$48 recruiting" />

            <TextView
                android:id="@+id/textNilNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_xs"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption"
                tools:text="Next: Tier 3 at $27,000 — budget $17,500 (65%)." />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:background="@drawable/bg_dialog_section"
            android:orientation="vertical"
            android:paddingStart="@dimen/cf_card_padding_h"
            android:paddingTop="@dimen/cf_card_padding_v"
            android:paddingEnd="@dimen/cf_card_padding_h"
            android:paddingBottom="@dimen/cf_card_padding_v">

            <TextView
                style="@style/Widget.Cfhc.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dlg_program_upgrades" />

            <TextView
                android:id="@+id/textCoachSkillXp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_sm"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatBold"
                android:textColor="@color/cf_emerald"
                tools:text="Skill XP: 120" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_md"
                android:labelFor="@+id/spinnerCoachSkillBranch"
                android:text="@string/dlg_program_branch"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Body"
                android:textColor="@color/cf_text_primary" />

            <Spinner
                android:id="@+id/spinnerCoachSkillBranch"
                style="@style/Widget.Cfhc.Spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_xs"
                android:minHeight="44dp" />

            <Button
                android:id="@+id/buttonCoachSkillUpgrade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="@dimen/cf_space_md"
                android:background="@drawable/bg_action_primary"
                android:fontFamily="@font/inter"
                android:textAllCaps="false"
                android:textColor="@color/cf_on_gold"
                android:textStyle="bold"
                tools:text="Upgrade (40 XP)" />

            <TextView
                android:id="@+id/textCoachProgramHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_sm"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption"
                android:textColor="@color/cf_text_muted"
                tools:text="Upgrade hint" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonCoachProgramClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="@dimen/cf_space_md"
            android:background="@drawable/bg_action_secondary"
            android:fontFamily="@font/inter"
            android:text="@string/dlg_close"
            android:textAllCaps="false"
            android:textColor="@color/cf_text_primary"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
