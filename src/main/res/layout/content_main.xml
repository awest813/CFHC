<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_field"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:showIn="@layout/app_bar_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/cf_space_sm"
        android:paddingEnd="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/cf_space_sm"
        tools:context="antdroid.cfbcoach.MainActivity"
        tools:showIn="@layout/activity_main">

        <!-- ============================================================ -->
        <!-- Broadcast header: team name + script nickname, then one row  -->
        <!-- of season / week / phase pills. Text is bound at runtime by  -->
        <!-- SeasonPresentationController; placeholders are tools: only.  -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hub_header"
            android:orientation="vertical"
            android:paddingStart="@dimen/cf_card_padding_h"
            android:paddingTop="@dimen/cf_space_sm"
            android:paddingEnd="@dimen/cf_space_md"
            android:paddingBottom="@dimen/cf_space_sm">

            <!-- Kicker badge ("2026 Season"). Hidden by default: the year pill
                 below carries the same fact; id kept for the controller. -->
            <TextView
                android:id="@+id/mainSeasonBadge"
                style="@style/Widget.Cfhc.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cf_gold"
                android:visibility="gone"
                tools:text="2026 Season"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mainSeasonTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Cfhc.Cf.Display"
                    app:autoSizeMaxTextSize="@dimen/cf_text_display"
                    app:autoSizeMinTextSize="@dimen/cf_text_title"
                    app:autoSizeTextType="uniform"
                    tools:text="Alabama 2026" />

                <TextView
                    android:id="@+id/mainSeasonNickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cf_space_sm"
                    android:contentDescription="@string/hub_a11y_nickname"
                    android:maxLines="1"
                    android:maxWidth="120dp"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.Cfhc.Cf.Script"
                    android:textColor="@color/cf_gold"
                    android:textSize="22sp"
                    android:visibility="gone"
                    tools:text="Crimson Tide"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Season / week / phase pills on one line. Year + week carry
                 numbers (mono); the phase pill flexes and ellipsizes so the
                 row never overflows at 360dp. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mainSeasonYearChip"
                    style="@style/Widget.Cfhc.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat"
                    android:textColor="@color/cf_text_primary"
                    android:textSize="11sp"
                    tools:text="Year 2026" />

                <TextView
                    android:id="@+id/mainSeasonWeekChip"
                    style="@style/Widget.Cfhc.Pill.Emerald"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cf_space_xs"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatBold"
                    android:textColor="@color/cf_emerald"
                    android:textSize="11sp"
                    tools:text="Week 5" />

                <TextView
                    android:id="@+id/mainSeasonPhaseChip"
                    style="@style/Widget.Cfhc.Pill.Gold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cf_space_xs"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical|start"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:textSize="11sp"
                    tools:text="Phase  Regular Season" />
            </LinearLayout>

            <!-- Optional next-action line; the controller shows it only when
                 the engine returns non-empty text. -->
            <TextView
                android:id="@+id/mainSeasonSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_xs"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption"
                android:visibility="gone"
                tools:text="Scout any team below or play the next week."
                tools:visibility="visible" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- Scout any team: two spinners on one compact row.             -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:background="@drawable/bg_cf_card"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="@dimen/cf_space_md"
            android:paddingTop="6dp"
            android:paddingEnd="@dimen/cf_space_md"
            android:paddingBottom="@dimen/cf_space_sm">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/labelExamineConference"
                    style="@style/Widget.Cfhc.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/examineConfSpinner"
                    android:maxLines="1"
                    android:text="@string/main_filter_conference" />

                <Spinner
                    android:id="@+id/examineConfSpinner"
                    style="@style/Widget.Cfhc.Spinner"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="@dimen/cf_space_xs"
                    android:background="@drawable/bg_hub_spinner"
                    android:contentDescription="@string/main_a11y_conference_spinner"
                    android:paddingStart="@dimen/cf_space_sm"
                    android:paddingEnd="26dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cf_space_sm"
                android:layout_weight="1.4"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/labelExamineTeam"
                    style="@style/Widget.Cfhc.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/examineTeamSpinner"
                    android:maxLines="1"
                    android:text="@string/main_filter_team" />

                <Spinner
                    android:id="@+id/examineTeamSpinner"
                    style="@style/Widget.Cfhc.Spinner"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="@dimen/cf_space_xs"
                    android:background="@drawable/bg_hub_spinner"
                    android:contentDescription="@string/main_a11y_team_spinner"
                    android:paddingStart="@dimen/cf_space_sm"
                    android:paddingEnd="26dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- Main list: takes every remaining dp. Populated by adapters.  -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:layout_weight="1"
            android:background="@drawable/bg_cf_card"
            android:orientation="vertical"
            android:padding="6dp">

            <ListView
                android:id="@+id/mainList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:cacheColorHint="@android:color/transparent"
                android:contentDescription="@string/main_standings_list_description"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:listSelector="@android:color/transparent"
                android:padding="0dp"
                android:scrollbarStyle="insideInset" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- Bottom action bar: Quick Browse (5 secondary) + Quick Actions -->
        <!-- (Depth Chart / Play Week gold CTA / Schemes).                -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:background="@drawable/bg_bottom_nav"
            android:orientation="vertical"
            android:paddingStart="@dimen/cf_space_sm"
            android:paddingTop="@dimen/cf_space_sm"
            android:paddingEnd="@dimen/cf_space_sm"
            android:paddingBottom="@dimen/cf_space_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_action_secondary"
                    android:fontFamily="@font/inter"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:onClick="openHomeView"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/quick_home"
                    android:textAllCaps="false"
                    android:textColor="@color/cf_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="@dimen/cf_space_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_action_secondary"
                    android:fontFamily="@font/inter"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:onClick="openRosterView"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/quick_roster"
                    android:textAllCaps="false"
                    android:textColor="@color/cf_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="@dimen/cf_space_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_action_secondary"
                    android:fontFamily="@font/inter"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:onClick="openTeamStatsView"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/hub_quick_stats"
                    android:textAllCaps="false"
                    android:textColor="@color/cf_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="@dimen/cf_space_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_action_secondary"
                    android:fontFamily="@font/inter"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:onClick="openScheduleView"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/quick_schedule"
                    android:textAllCaps="false"
                    android:textColor="@color/cf_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="@dimen/cf_space_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_action_secondary"
                    android:fontFamily="@font/inter"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:onClick="openLeagueDrawer"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/quick_league"
                    android:textAllCaps="false"
                    android:textColor="@color/cf_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonDepthChart"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_action_secondary"
                    android:fontFamily="@font/inter"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/main_depth_chart"
                    android:textAllCaps="false"
                    android:textColor="@color/cf_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/simGameButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="@dimen/cf_space_sm"
                    android:layout_marginEnd="@dimen/cf_space_sm"
                    android:layout_weight="1.6"
                    android:background="@drawable/bg_action_primary"
                    android:fontFamily="@font/inter"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="2"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/main_play_week"
                    android:textAllCaps="false"
                    android:textColor="@color/cf_on_gold"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/buttonStrategy"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_action_secondary"
                    android:fontFamily="@font/inter"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/main_playbook"
                    android:textAllCaps="false"
                    android:textColor="@color/cf_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
