<?xml version="1.0" encoding="utf-8"?>
<!-- Depth chart shell: position spinner + minimum-players line in a header card, format hint,
     lineup list card, secondary Save and gold Close. ids bound by DepthChartDialogController. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog_surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/cf_space_lg"
    android:paddingTop="@dimen/cf_space_lg"
    android:paddingEnd="@dimen/cf_space_lg"
    android:paddingBottom="@dimen/cf_space_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_section"
        android:orientation="vertical"
        android:paddingStart="@dimen/cf_card_padding_h"
        android:paddingTop="@dimen/cf_card_padding_v"
        android:paddingEnd="@dimen/cf_card_padding_h"
        android:paddingBottom="@dimen/cf_card_padding_v">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.Cfhc.Pill.Emerald"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dlg_pill_depth" />

            <TextView
                style="@style/Widget.Cfhc.CardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cf_space_md"
                android:layout_weight="1"
                android:gravity="end"
                android:labelFor="@+id/spinnerTeamLineupPosition"
                android:text="@string/dlg_lineup_position" />
        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerTeamLineupPosition"
            style="@style/Widget.Cfhc.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:minHeight="44dp" />

        <TextView
            android:id="@+id/textMinPlayers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatBold"
            android:textColor="@color/cf_gold"
            tools:text="Minimum Active Players: 2" />

        <TextView
            android:id="@+id/textViewLineupPositionDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_xs"
            android:text="@string/dlg_lineup_format"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption" />
    </LinearLayout>

    <ListView
        android:id="@+id/listViewTeamLineup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/cf_space_sm"
        android:layout_weight="1"
        android:background="@drawable/bg_dialog_section"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/cf_space_sm"
        android:listSelector="@drawable/bg_cf_list_selector"
        android:padding="@dimen/cf_space_sm" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cf_space_sm"
        android:gravity="center"
        android:text="@string/dlg_lineup_hint"
        android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption"
        android:textColor="@color/cf_text_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cf_space_md"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonSaveLineups"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginEnd="@dimen/cf_space_xs"
            android:layout_weight="1"
            android:background="@drawable/bg_action_secondary"
            android:fontFamily="@font/inter"
            android:text="@string/dlg_lineup_save"
            android:textAllCaps="false"
            android:textColor="@color/cf_text_primary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonDoneWithLineups"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginStart="@dimen/cf_space_xs"
            android:layout_weight="1"
            android:background="@drawable/bg_action_primary"
            android:fontFamily="@font/inter"
            android:text="@string/dlg_close"
            android:textAllCaps="false"
            android:textColor="@color/cf_on_gold"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
