<?xml version="1.0" encoding="utf-8"?>
<!-- Team history row: season summary line (Inter title) over detail lines. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cf_card"
    android:foreground="@drawable/bg_cf_ripple"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/cf_card_padding_h"
    android:paddingTop="@dimen/cf_space_sm"
    android:paddingEnd="@dimen/cf_card_padding_h"
    android:paddingBottom="@dimen/cf_space_sm">

    <TextView
        android:id="@+id/textViewTeamHistoryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Cfhc.Cf.Title"
        tools:text="2031: #3 Team (11-2) CC BW" />

    <TextView
        android:id="@+id/textViewTeamHistoryDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cf_space_xs"
        android:paddingStart="@dimen/cf_space_sm"
        android:paddingEnd="0dp"
        android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption"
        tools:text="Bowl: W 31-20 vs Opponent" />
</LinearLayout>
