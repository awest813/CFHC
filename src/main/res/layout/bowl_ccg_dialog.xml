<?xml version="1.0" encoding="utf-8"?>
<!-- Postseason / archive shell: trophy sprite header with pill + title + subtitle
     (title/subtitle rebound via PlatformUiHelper.bindArchiveDialogShell), bracket spinner,
     then the bracket rows in a mono results card (textViewBowlCCGDialog). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog_surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/cf_space_lg"
    android:paddingTop="@dimen/cf_space_lg"
    android:paddingEnd="@dimen/cf_space_lg"
    android:paddingBottom="@dimen/cf_space_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_section"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/cf_card_padding_h"
        android:paddingTop="@dimen/cf_card_padding_v"
        android:paddingEnd="@dimen/cf_card_padding_h"
        android:paddingBottom="@dimen/cf_card_padding_v">

        <ImageView
            android:layout_width="@dimen/cf_sprite_avatar_width"
            android:layout_height="@dimen/cf_sprite_avatar_height"
            android:background="@drawable/bg_cf_card_canvas"
            android:contentDescription="@string/dlg_cd_trophy"
            android:scaleType="fitCenter"
            android:src="@drawable/sprite_trophy_crystal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cf_space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textArchiveShellLabel"
                style="@style/Widget.Cfhc.Pill.Gold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_shell_label" />

            <TextView
                android:id="@+id/textArchiveShellTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_xs"
                android:text="@string/dialog_shell_archive_title"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Display" />

            <TextView
                android:id="@+id/textArchiveShellSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/dialog_shell_archive_subtitle"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/Widget.Cfhc.CardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cf_space_md"
        android:labelFor="@+id/spinnerBowlCCG"
        android:text="@string/dlg_bowl_select" />

    <Spinner
        android:id="@+id/spinnerBowlCCG"
        style="@style/Widget.Cfhc.Spinner"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/cf_space_xs" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/cf_space_sm"
        android:layout_weight="1"
        android:background="@drawable/bg_dialog_section"
        android:orientation="vertical"
        android:paddingStart="@dimen/cf_card_padding_h"
        android:paddingTop="@dimen/cf_card_padding_v"
        android:paddingEnd="@dimen/cf_card_padding_h"
        android:paddingBottom="@dimen/cf_card_padding_v">

        <TextView
            style="@style/Widget.Cfhc.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dlg_bowl_results" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:layout_weight="1"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/textViewBowlCCGDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat"
                android:textColor="@color/cf_text_primary"
                tools:text="Rose Bowl\n#3 Team A 31 — #6 Team B 27" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
