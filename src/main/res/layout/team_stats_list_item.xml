<?xml version="1.0" encoding="utf-8"?>
<!-- Team-stat compare row: label (Inter) · your value (emerald rating tile, mono) · opponent (mono, right). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cf_card"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/cf_card_padding_h"
    android:paddingTop="@dimen/cf_space_sm"
    android:paddingEnd="@dimen/cf_card_padding_h"
    android:paddingBottom="@dimen/cf_space_sm">

    <TextView
        android:id="@+id/textTeamStatsLeft"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Cfhc.Cf.Body"
        tools:text="Points / Game" />

    <TextView
        android:id="@+id/textTeamStatsCenter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cf_space_sm"
        android:layout_marginEnd="@dimen/cf_space_sm"
        android:layout_weight="0.85"
        android:background="@drawable/bg_cf_rating_tile"
        android:gravity="end|center_vertical"
        android:paddingStart="@dimen/cf_space_sm"
        android:paddingTop="6dp"
        android:paddingEnd="@dimen/cf_space_sm"
        android:paddingBottom="6dp"
        android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatBold"
        android:textColor="@color/cf_emerald"
        tools:text="34.2 (3)" />

    <TextView
        android:id="@+id/textTeamStatsRight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.85"
        android:gravity="end"
        android:textAlignment="viewEnd"
        android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat"
        android:textColor="@color/cf_text_secondary"
        tools:text="21.7 (44)" />
</LinearLayout>
