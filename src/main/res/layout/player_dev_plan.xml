<?xml version="1.0" encoding="utf-8"?>
<!-- Development plan shell: player header card (name, info line, current-plan gold pill),
     then an "Available plans" card whose rows are added by PlayerDevelopmentDialogController. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/cf_space_lg"
        android:paddingTop="@dimen/cf_space_lg"
        android:paddingEnd="@dimen/cf_space_lg"
        android:paddingBottom="@dimen/cf_space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog_section"
            android:orientation="vertical"
            android:paddingStart="@dimen/cf_card_padding_h"
            android:paddingTop="@dimen/cf_card_padding_v"
            android:paddingEnd="@dimen/cf_card_padding_h"
            android:paddingBottom="@dimen/cf_card_padding_v">

            <TextView
                style="@style/Widget.Cfhc.Pill.Emerald"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dlg_pill_plan" />

            <TextView
                android:id="@+id/dpPlayerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_sm"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Display"
                tools:text="Player Name" />

            <TextView
                android:id="@+id/dpPlayerInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat"
                android:textColor="@color/cf_text_secondary"
                tools:text="QB | Junior | 86 OVR" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Cfhc.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dlg_plan_current" />

                <TextView
                    android:id="@+id/dpCurrentPlan"
                    style="@style/Widget.Cfhc.Pill.Gold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Current: Pocket Passer" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:background="@drawable/bg_dialog_section"
            android:orientation="vertical"
            android:paddingStart="@dimen/cf_card_padding_h"
            android:paddingTop="@dimen/cf_card_padding_v"
            android:paddingEnd="@dimen/cf_card_padding_h"
            android:paddingBottom="@dimen/cf_card_padding_v">

            <TextView
                style="@style/Widget.Cfhc.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dlg_plan_available" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_xs"
                android:text="@string/dlg_plan_available_body"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption" />

            <LinearLayout
                android:id="@+id/dpArchetypeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_sm"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
