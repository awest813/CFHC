<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_menu"
    android:orientation="vertical"
    android:paddingStart="@dimen/cf_space_lg"
    android:paddingTop="@dimen/cf_space_md"
    android:paddingEnd="@dimen/cf_space_lg"
    android:paddingBottom="@dimen/cf_space_md"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="antdroid.cfbcoach.recruiting.RecruitingActivity"
    tools:showIn="@layout/activity_recruiting">

    <!-- ============ Budget / board header card ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/cf_space_sm"
        android:background="@drawable/bg_cf_card_elevated"
        android:orientation="vertical"
        android:paddingStart="@dimen/cf_card_padding_h"
        android:paddingTop="@dimen/cf_card_padding_v"
        android:paddingEnd="@dimen/cf_card_padding_h"
        android:paddingBottom="@dimen/cf_card_padding_v">

        <TextView
            style="@style/Widget.Cfhc.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recruiting_hub_label" />

        <TextView
            android:id="@+id/textRecruitProgramName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_xs"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/recruiting_program_title_default"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Display"
            tools:text="Lions Recruiting" />

        <TextView
            android:id="@+id/textRecruitSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_xs"
            android:text="@string/recruiting_hub_subtitle"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_md"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/cf_space_xs"
                android:layout_weight="1"
                android:background="@drawable/bg_rec_budget_tile"
                android:orientation="vertical"
                android:paddingStart="@dimen/cf_space_md"
                android:paddingTop="@dimen/cf_space_sm"
                android:paddingEnd="@dimen/cf_space_md"
                android:paddingBottom="@dimen/cf_space_sm">

                <TextView
                    style="@style/Widget.Cfhc.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rec_label_budget" />

                <TextView
                    android:id="@+id/textRecBudget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/recruiting_budget_default"
                    android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatAccent"
                    android:textSize="@dimen/cf_text_title"
                    tools:text="Budget: $1,450" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/cf_space_xs"
                android:layout_weight="1"
                android:background="@drawable/bg_cf_card_canvas"
                android:orientation="vertical"
                android:paddingStart="@dimen/cf_space_md"
                android:paddingTop="@dimen/cf_space_sm"
                android:paddingEnd="@dimen/cf_space_md"
                android:paddingBottom="@dimen/cf_space_sm">

                <TextView
                    style="@style/Widget.Cfhc.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rec_label_board" />

                <TextView
                    android:id="@+id/textRecruitBoardStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/recruiting_board_status_default"
                    android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatBold"
                    tools:text="Board: 48 prospects" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ============ Board controls card ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/cf_space_sm"
        android:background="@drawable/bg_cf_card"
        android:orientation="vertical"
        android:paddingStart="@dimen/cf_card_padding_h"
        android:paddingTop="@dimen/cf_card_padding_v"
        android:paddingEnd="@dimen/cf_card_padding_h"
        android:paddingBottom="@dimen/cf_card_padding_v">

        <TextView
            style="@style/Widget.Cfhc.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recruiting_controls_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerRec"
                style="@style/Widget.Cfhc.Spinner"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="@dimen/cf_space_sm"
                android:layout_weight="1"
                android:contentDescription="@string/rec_label_lane"
                android:spinnerMode="dropdown" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRecruitExpandCollapse"
                style="@style/Widget.Cfhc.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/recruiting_button_options"
                android:textSize="@dimen/cf_text_stat"
                app:insetBottom="0dp"
                app:insetTop="0dp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/filterSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_xs"
            android:fontFamily="@font/inter"
            android:minHeight="44dp"
            android:text="@string/recruiting_filter_label"
            android:textColor="@color/cf_text_primary"
            android:textSize="@dimen/cf_text_stat" />
    </LinearLayout>

    <!-- ============ Recruiting board ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/cf_space_sm"
        android:layout_weight="1"
        android:background="@drawable/bg_cf_card"
        android:orientation="vertical"
        android:paddingStart="@dimen/cf_card_padding_h"
        android:paddingTop="@dimen/cf_card_padding_v"
        android:paddingEnd="@dimen/cf_card_padding_h"
        android:paddingBottom="@dimen/cf_space_xs">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.Cfhc.CardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/recruiting_board_title" />

            <TextView
                style="@style/Widget.Cfhc.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rec_label_grade" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/cf_stroke"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:background="@color/cf_divider" />

        <ExpandableListView
            android:id="@+id/recruitExpandList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:childDivider="@android:color/transparent"
            android:clipToPadding="false"
            android:contentDescription="@string/rec_cd_board_list"
            android:divider="@android:color/transparent"
            android:groupIndicator="@null"
            android:listSelector="@drawable/bg_cf_list_selector"
            android:paddingTop="@dimen/cf_space_sm"
            android:paddingBottom="@dimen/cf_space_sm"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- ============ Footer actions: one gold primary ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRecRoster"
            style="@style/Widget.Cfhc.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/cf_space_xs"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/recruiting_button_roster"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDoneRecruiting"
            style="@style/Widget.Cfhc.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cf_space_xs"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/recruiting_button_done"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
