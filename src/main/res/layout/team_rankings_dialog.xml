<?xml version="1.0" encoding="utf-8"?>
<!-- Shared rankings/list shell (used by rankings, awards, news, scores, history, careers).
     Title/subtitle rebound via PlatformUiHelper.bindRankingsDialogShell; spinner + list ids
     are bound by each controller. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="550dp"
    android:background="@drawable/bg_dialog_surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/cf_space_lg"
    android:paddingTop="@dimen/cf_space_lg"
    android:paddingEnd="@dimen/cf_space_lg"
    android:paddingBottom="@dimen/cf_space_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_section"
        android:orientation="vertical"
        android:paddingStart="@dimen/cf_card_padding_h"
        android:paddingTop="@dimen/cf_card_padding_v"
        android:paddingEnd="@dimen/cf_card_padding_h"
        android:paddingBottom="@dimen/cf_card_padding_v">

        <TextView
            android:id="@+id/textDialogShellLabel"
            style="@style/Widget.Cfhc.Pill.Emerald"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_shell_label" />

        <TextView
            android:id="@+id/textDialogShellTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:text="@string/dialog_shell_rankings_title"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Display" />

        <TextView
            android:id="@+id/textDialogShellSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/dialog_shell_rankings_subtitle"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption" />
    </LinearLayout>

    <TextView
        style="@style/Widget.Cfhc.CardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cf_space_md"
        android:labelFor="@+id/spinnerTeamRankings"
        android:text="@string/dlg_rankings_view" />

    <Spinner
        android:id="@+id/spinnerTeamRankings"
        style="@style/Widget.Cfhc.Spinner"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/cf_space_xs" />

    <ListView
        android:id="@+id/listViewTeamRankings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/cf_space_sm"
        android:layout_weight="1"
        android:background="@drawable/bg_dialog_section"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/cf_space_sm"
        android:listSelector="@drawable/bg_cf_list_selector"
        android:padding="@dimen/cf_space_sm" />
</LinearLayout>
