<?xml version="1.0" encoding="utf-8"?>
<!-- Season Goals: projection tiles over the full goals briefing. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/cf_space_lg">

        <TextView
            android:id="@+id/goalsPill"
            style="@style/Widget.Cfhc.Pill.Gold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="2026 Season" />

        <TextView
            android:id="@+id/goalsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:text="@string/goals_title"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Display" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_md"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_cf_rating_tile"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/cf_space_sm">

                <TextView
                    style="@style/Widget.Cfhc.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goals_projected_rank" />

                <TextView
                    android:id="@+id/goalsRank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Cfhc.Cf.Rating"
                    android:textSize="28sp"
                    tools:text="#14" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cf_space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_cf_card_canvas"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/cf_space_sm">

                <TextView
                    style="@style/Widget.Cfhc.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goals_projected_record" />

                <TextView
                    android:id="@+id/goalsRecord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatBold"
                    android:textSize="28sp"
                    tools:text="9-3" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:background="@drawable/bg_cf_card_canvas"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/cf_card_padding_h"
            android:paddingEnd="@dimen/cf_card_padding_h">

            <TextView
                style="@style/Widget.Cfhc.CardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/goals_conference_finish" />

            <TextView
                android:id="@+id/goalsConference"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatAccent"
                tools:text="3rd · Great North" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:background="@drawable/bg_dialog_section"
            android:orientation="vertical"
            android:paddingStart="@dimen/cf_card_padding_h"
            android:paddingTop="@dimen/cf_card_padding_v"
            android:paddingEnd="@dimen/cf_card_padding_h"
            android:paddingBottom="@dimen/cf_card_padding_v">

            <TextView
                style="@style/Widget.Cfhc.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/goals_briefing" />

            <TextView
                android:id="@+id/goalsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_xs"
                android:lineSpacingExtra="2dp"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Body"
                android:textColor="@color/cf_text_primary"
                tools:text="Welcome to the season, Coach." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_sm"
                android:text="@string/goals_footnote"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
