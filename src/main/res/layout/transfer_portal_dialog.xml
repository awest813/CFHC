<?xml version="1.0" encoding="utf-8"?>
<!-- Transfer portal shell: header card (pill, title, subtitle, mode + position spinners),
     status row (count in mono), registry list / summary card, secondary close.
     ids bound by TransferDialogController. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog_surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/cf_space_lg"
    android:paddingTop="@dimen/cf_space_lg"
    android:paddingEnd="@dimen/cf_space_lg"
    android:paddingBottom="@dimen/cf_space_lg">

    <!-- Header Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_section"
        android:orientation="vertical"
        android:paddingStart="@dimen/cf_card_padding_h"
        android:paddingTop="@dimen/cf_card_padding_v"
        android:paddingEnd="@dimen/cf_card_padding_h"
        android:paddingBottom="@dimen/cf_card_padding_v">

        <TextView
            style="@style/Widget.Cfhc.Pill.Emerald"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dlg_pill_portal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:text="@string/transfer_portal_title"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/transfer_portal_subtitle"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption" />

        <TextView
            style="@style/Widget.Cfhc.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_md"
            android:labelFor="@+id/spinnerTransferMode"
            android:text="@string/dlg_portal_mode" />

        <!-- Mode Selector Spinner -->
        <Spinner
            android:id="@+id/spinnerTransferMode"
            style="@style/Widget.Cfhc.Spinner"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/cf_space_xs" />

        <!-- Position Filter (visible only in Registry mode) -->
        <Spinner
            android:id="@+id/spinnerTransferPos"
            style="@style/Widget.Cfhc.Spinner"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/cf_space_sm" />
    </LinearLayout>

    <!-- Registry Status / Summary Header -->
    <LinearLayout
        android:id="@+id/layoutTransferStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cf_space_sm"
        android:layout_marginBottom="@dimen/cf_space_xs"
        android:gravity="center_vertical"
        android:minHeight="28dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/cf_space_xs"
        android:paddingEnd="@dimen/cf_space_xs">

        <TextView
            android:id="@+id/textTransferCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatAccent"
            tools:text="24 transfers in portal" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/textTransferTapHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_search_tap_hint"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Micro" />
    </LinearLayout>

    <!-- Registry List Container -->
    <FrameLayout
        android:id="@+id/layoutTransferRegistry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listTransferPlayers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@android:color/transparent"
            android:dividerHeight="@dimen/cf_space_sm"
            android:listSelector="@drawable/bg_cf_list_selector"
            android:scrollbarStyle="insideInset" />

        <TextView
            android:id="@+id/textTransferEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_dialog_section"
            android:gravity="center"
            android:padding="@dimen/cf_space_lg"
            android:text="@string/dlg_portal_empty"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Body"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Text Summary Container (Program & League summaries) -->
    <ScrollView
        android:id="@+id/scrollTransferSummary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_dialog_section"
        android:paddingStart="@dimen/cf_card_padding_h"
        android:paddingTop="@dimen/cf_card_padding_v"
        android:paddingEnd="@dimen/cf_card_padding_h"
        android:paddingBottom="@dimen/cf_card_padding_v"
        android:visibility="gone">

        <TextView
            android:id="@+id/textTransferSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Body"
            android:textColor="@color/cf_text_primary"
            tools:text="Program summary" />
    </ScrollView>

    <!-- Close Button -->
    <Button
        android:id="@+id/buttonCloseTransfer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="@dimen/cf_space_sm"
        android:background="@drawable/bg_action_secondary"
        android:fontFamily="@font/inter"
        android:text="@string/dlg_close"
        android:textAllCaps="false"
        android:textColor="@color/cf_text_primary"
        android:textSize="@dimen/cf_text_body"
        android:textStyle="bold" />
</LinearLayout>
