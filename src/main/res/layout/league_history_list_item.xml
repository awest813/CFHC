<?xml version="1.0" encoding="utf-8"?>
<!-- League history / season awards row: season header (Inter title) with two detail lines. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cf_card"
    android:foreground="@drawable/bg_cf_ripple"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/cf_card_padding_h"
    android:paddingTop="@dimen/cf_card_padding_v"
    android:paddingEnd="@dimen/cf_card_padding_h"
    android:paddingBottom="@dimen/cf_card_padding_v">

    <TextView
        android:id="@+id/textViewLeagueHistoryTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Cfhc.Cf.Title"
        tools:text="2031 Season" />

    <TextView
        android:id="@+id/textViewLeagueHistoryMiddle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cf_space_xs"
        android:textAppearance="@style/TextAppearance.Cfhc.Cf.Body"
        tools:text="Champions: TEAM" />

    <TextView
        android:id="@+id/textViewLeagueHistoryBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cf_space_xs"
        android:textAppearance="@style/TextAppearance.Cfhc.Cf.Body"
        tools:text="Player of the Year: QB A. Player" />
</LinearLayout>
