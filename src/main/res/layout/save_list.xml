<?xml version="1.0" encoding="utf-8"?>
<!-- List row shared by SaveFilesList (save slots), StatsRowAdapter and MockDraft.
     Keep the three ids and their default visibility: the adapters toggle them.
     Save slots: line 1 = league / team (Inter), line 2 = mode | playoff (caption),
     line 3 = version / compatibility (mono). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/cf_space_sm"
    android:paddingTop="@dimen/cf_space_xs"
    android:paddingEnd="@dimen/cf_space_sm"
    android:paddingBottom="@dimen/cf_space_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cf_card"
        android:minHeight="56dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/cf_card_padding_h"
        android:paddingTop="@dimen/cf_card_padding_v"
        android:paddingEnd="@dimen/cf_card_padding_h"
        android:paddingBottom="@dimen/cf_card_padding_v">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Slot ordinal; only SaveFilesList shows it (gone for the shared adapters). -->
            <TextView
                android:id="@+id/homeSaveSlotNumber"
                style="@style/Widget.Cfhc.Pill.Gold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/cf_space_sm"
                android:contentDescription="@string/home_save_slot_label"
                android:minWidth="28dp"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatAccent"
                android:visibility="gone"
                tools:text="1"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/textPlayerStatsLeftChild"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Title"
                android:textSize="15sp"
                tools:text="Dynasty save title" />
        </LinearLayout>

        <TextView
            android:id="@+id/textPlayerStatsCenter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_xs"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption"
            android:visibility="gone"
            tools:text="Open Dynasty  |  12-Team Playoff"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textPlayerStatsRightChild"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_xs"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatAccent"
            android:textSize="@dimen/cf_text_caption"
            android:visibility="gone"
            tools:text="Version: 1.5"
            tools:visibility="visible" />
    </LinearLayout>
</FrameLayout>
