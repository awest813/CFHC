<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_nav_header"
    android:gravity="bottom|center_vertical"
    android:minHeight="132dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/cf_space_lg"
    android:paddingTop="@dimen/cf_space_xxl"
    android:paddingEnd="@dimen/cf_space_lg"
    android:paddingBottom="@dimen/cf_space_md"
    android:theme="@style/ThemeOverlay.Material3.Dark">

    <TextView
        android:id="@+id/navMono"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_hub_mono"
        android:contentDescription="@string/hub_a11y_mono"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Cfhc.Cf.Title"
        android:textColor="@color/cf_emerald"
        tools:text="BC" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cf_space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.Cfhc.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/hub_nav_kicker"
            android:textColor="@color/cf_gold" />

        <TextView
            android:id="@+id/navTextTeam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_xs"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/nav_header_no_team"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Title"
            tools:text="Boston College" />

        <TextView
            android:id="@+id/navTextRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Stat"
            android:textColor="@color/cf_text_secondary"
            tools:text="#12  ·  5-2  ·  ACC" />
    </LinearLayout>

</LinearLayout>
