<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="124dp"
    android:background="@drawable/bg_nav_header"
    android:gravity="bottom|center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/cf_space_lg"
    android:paddingTop="@dimen/cf_space_xxl"
    android:paddingEnd="@dimen/cf_space_lg"
    android:paddingBottom="@dimen/cf_space_md"
    android:theme="@style/ThemeOverlay.Material3.Dark">

    <!-- Pixel crest (sprite box, keep fitCenter so the pixel look survives). -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_cf_card_canvas"
        android:contentDescription="@string/hub_nav_crest_desc"
        android:padding="4dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/sprite_crest_wildcats" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cf_space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.Cfhc.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/nav_header_title"
            android:textColor="@color/cf_gold" />

        <TextView
            android:id="@+id/navTextTeam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_xs"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/nav_header_no_team"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Title"
            android:visibility="visible"
            tools:text="#4 Alabama (11-1) CC NCW" />
    </LinearLayout>

</LinearLayout>
