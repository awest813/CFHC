<?xml version="1.0" encoding="utf-8"?>
<!-- Program editor shell: header card (beta pill, title, subtitle, warning), target card
     (conference/team spinners), identity card (bg_cf_input fields, prestige in mono),
     secondary Back + gold Save. ids bound by LeagueEditorDialogController. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/cf_space_lg"
        android:paddingTop="@dimen/cf_space_lg"
        android:paddingEnd="@dimen/cf_space_lg"
        android:paddingBottom="@dimen/cf_space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog_section"
            android:orientation="vertical"
            android:paddingStart="@dimen/cf_card_padding_h"
            android:paddingTop="@dimen/cf_card_padding_v"
            android:paddingEnd="@dimen/cf_card_padding_h"
            android:paddingBottom="@dimen/cf_card_padding_v">

            <TextView
                style="@style/Widget.Cfhc.Pill.Gold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dlg_pill_editor" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_sm"
                android:text="@string/editor_panel_title"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_xs"
                android:lineSpacingExtra="2dp"
                android:text="@string/editor_panel_subtitle"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Body" />

            <TextView
                android:id="@+id/editorHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_sm"
                android:background="@drawable/bg_cf_card_crimson"
                android:paddingStart="@dimen/cf_space_md"
                android:paddingTop="@dimen/cf_space_sm"
                android:paddingEnd="@dimen/cf_space_md"
                android:paddingBottom="@dimen/cf_space_sm"
                android:text="@string/editor_warning"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption"
                android:textColor="@color/cf_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:background="@drawable/bg_dialog_section"
            android:orientation="vertical"
            android:paddingStart="@dimen/cf_card_padding_h"
            android:paddingTop="@dimen/cf_card_padding_v"
            android:paddingEnd="@dimen/cf_card_padding_h"
            android:paddingBottom="@dimen/cf_card_padding_v">

            <TextView
                style="@style/Widget.Cfhc.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dlg_editor_target" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_sm"
                android:labelFor="@+id/confList"
                android:text="@string/editor_select_conference"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Body"
                android:textColor="@color/cf_text_primary" />

            <Spinner
                android:id="@+id/confList"
                style="@style/Widget.Cfhc.Spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_xs"
                android:minHeight="44dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_md"
                android:labelFor="@+id/teamList"
                android:text="@string/editor_select_team"
                android:textAppearance="@style/TextAppearance.Cfhc.Cf.Body"
                android:textColor="@color/cf_text_primary" />

            <Spinner
                android:id="@+id/teamList"
                style="@style/Widget.Cfhc.Spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cf_space_xs"
                android:minHeight="44dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_sm"
            android:background="@drawable/bg_dialog_section"
            android:orientation="vertical"
            android:paddingStart="@dimen/cf_card_padding_h"
            android:paddingTop="@dimen/cf_card_padding_v"
            android:paddingEnd="@dimen/cf_card_padding_h"
            android:paddingBottom="@dimen/cf_card_padding_v">

            <TextView style="@style/Widget.Cfhc.CardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dlg_editor_identity" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_sm" android:labelFor="@+id/editTextChangeConf" android:text="@string/editor_team_conf" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption" />
            <EditText android:id="@+id/editTextChangeConf" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_xs" android:background="@drawable/bg_cf_input" android:fontFamily="@font/inter" android:importantForAutofill="no" android:inputType="text" android:minHeight="44dp" android:paddingStart="@dimen/cf_space_md" android:paddingEnd="@dimen/cf_space_md" android:textColor="@color/cf_text_primary" android:textColorHint="@color/cf_text_muted" android:textSize="@dimen/cf_text_body" tools:text="Big Conference" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_md" android:labelFor="@+id/editTextChangeName" android:text="@string/editor_team_name" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption" />
            <EditText android:id="@+id/editTextChangeName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_xs" android:background="@drawable/bg_cf_input" android:fontFamily="@font/inter" android:importantForAutofill="no" android:inputType="text" android:minHeight="44dp" android:paddingStart="@dimen/cf_space_md" android:paddingEnd="@dimen/cf_space_md" android:textColor="@color/cf_text_primary" android:textColorHint="@color/cf_text_muted" android:textSize="@dimen/cf_text_body" tools:text="State University" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_md" android:labelFor="@+id/editTextChangeAbbr" android:text="@string/editor_team_abbr" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption" />
            <EditText android:id="@+id/editTextChangeAbbr" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_xs" android:background="@drawable/bg_cf_input" android:fontFamily="@font/jetbrains_mono" android:importantForAutofill="no" android:inputType="textCapCharacters" android:minHeight="44dp" android:paddingStart="@dimen/cf_space_md" android:paddingEnd="@dimen/cf_space_md" android:textColor="@color/cf_text_primary" android:textColorHint="@color/cf_text_muted" android:textSize="@dimen/cf_text_body" tools:text="STU" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_md" android:labelFor="@+id/editTextChangeHC" android:text="@string/editor_head_coach" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption" />
            <EditText android:id="@+id/editTextChangeHC" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_xs" android:background="@drawable/bg_cf_input" android:fontFamily="@font/inter" android:importantForAutofill="no" android:inputType="textPersonName" android:minHeight="44dp" android:paddingStart="@dimen/cf_space_md" android:paddingEnd="@dimen/cf_space_md" android:textColor="@color/cf_text_primary" android:textColorHint="@color/cf_text_muted" android:textSize="@dimen/cf_text_body" tools:text="Head Coach" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_md" android:labelFor="@+id/editLocation" android:text="@string/editor_location" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption" />
            <EditText android:id="@+id/editLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_xs" android:background="@drawable/bg_cf_input" android:fontFamily="@font/jetbrains_mono" android:importantForAutofill="no" android:inputType="text" android:minHeight="44dp" android:paddingStart="@dimen/cf_space_md" android:paddingEnd="@dimen/cf_space_md" android:textColor="@color/cf_text_primary" android:textColorHint="@color/cf_text_muted" android:textSize="@dimen/cf_text_body" tools:text="2" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_md" android:labelFor="@+id/editPrestige" android:text="@string/editor_prestige" android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption" />
            <EditText android:id="@+id/editPrestige" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cf_space_xs" android:background="@drawable/bg_cf_input" android:fontFamily="@font/jetbrains_mono" android:importantForAutofill="no" android:inputType="number" android:minHeight="44dp" android:paddingStart="@dimen/cf_space_md" android:paddingEnd="@dimen/cf_space_md" android:textColor="@color/cf_text_primary" android:textColorHint="@color/cf_text_muted" android:textSize="@dimen/cf_text_body" tools:text="75" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cf_space_md"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonCancelChangeName"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/cf_space_xs"
                android:layout_weight="1"
                android:background="@drawable/bg_action_secondary"
                android:fontFamily="@font/inter"
                android:text="@string/editor_back"
                android:textAllCaps="false"
                android:textColor="@color/cf_text_primary"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonOkChangeName"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/cf_space_xs"
                android:layout_weight="1"
                android:background="@drawable/bg_action_primary"
                android:fontFamily="@font/inter"
                android:text="@string/editor_save"
                android:textAllCaps="false"
                android:textColor="@color/cf_on_gold"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
