<?xml version="1.0" encoding="utf-8"?>
<!-- ui.components.PlayerSpriteCardView: avatar | name + detail | overall tile. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="horizontal"
    tools:parentTag="android.widget.LinearLayout">

    <ImageView
        android:id="@+id/cmpSpriteAvatar"
        android:layout_width="@dimen/cf_sprite_avatar_width"
        android:layout_height="@dimen/cf_sprite_avatar_height"
        android:layout_margin="@dimen/cf_space_sm"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cmpSpriteName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Body"
            tools:text="J. Carter" />

        <TextView
            android:id="@+id/cmpSpriteDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Cfhc.Cf.Caption"
            tools:text="QB · Senior" />
    </LinearLayout>

    <TextView
        android:id="@+id/cmpSpriteOverall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/cf_space_sm"
        android:background="@drawable/bg_cf_rating_tile"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:minWidth="@dimen/cf_pill_width"
        android:padding="@dimen/cf_space_xs"
        android:textAppearance="@style/TextAppearance.Cfhc.Cf.StatAccent"
        tools:text="88" />
</merge>
